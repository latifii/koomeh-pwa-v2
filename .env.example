# Public API origin used by the browser and by server-side prefetching.
NEXT_PUBLIC_API_BASE_URL=https://koomeh.ir

# Signs the session cookie. Must be at least 32 characters and must differ
# between environments — anyone holding it can mint a valid session.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-me-with-a-32-character-or-longer-random-string
