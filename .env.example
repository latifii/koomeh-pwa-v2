# Public API origin used by the browser and by server-side prefetching.
NEXT_PUBLIC_API_BASE_URL=https://koomeh.ir

# Signs the session cookie. Must be at least 32 characters and must differ
# between environments — anyone holding it can mint a valid session.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-me-with-a-32-character-or-longer-random-string

# Shared secret for POST /api/revalidate, which purges cached pages and data.
# The backend sends it as the `x-revalidate-secret` header when content
# changes. Without it the route refuses every request, and caches only ever
# expire on their own timers.
REVALIDATE_SECRET=replace-me-with-another-random-string

# The public origin this app is served from — used for sitemap entries,
# canonical links, Open Graph URLs and JSON-LD ids. Distinct from
# NEXT_PUBLIC_API_BASE_URL, which points at the backend. Defaults to
# https://koomeh.ir when unset.
NEXT_PUBLIC_SITE_URL=https://koomeh.ir
